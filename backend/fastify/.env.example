# ==============================================================================
# VeloStream Fastify API (.env) — DO NOT COMMIT REAL CREDENTIALS
# Update DATABASE_URL and CLOUDINARY_URL below with your real credentials.
# ==============================================================================

NODE_ENV=development
FASTIFY_HOST=0.0.0.0
FASTIFY_PORT=3001
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection (owned by backend/fastify Prisma schema & migrations)
# Example for local Windows PostgreSQL 17:
#   postgresql://postgres:YOUR_PASSWORD@localhost:5432/velostream?schema=public
DATABASE_URL=postgresql://velostream:velostream_dev_password@localhost:5432/velostream?schema=public

# Asymmetric JWT signing & verification (relative to backend/fastify/)
JWT_ALGORITHM=EdDSA
JWT_ISSUER=velostream-fastify
JWT_AUDIENCE=velostream-clients
JWT_PRIVATE_KEY_PATH=../../.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../../.keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# MediaMTX Webhook Shared Secret
MEDIA_WEBHOOK_SECRET=dev_mediamtx_webhook_secret_change_me

# Cloudinary Media Storage (format: cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_AVATAR_FOLDER=VeloStream/avatar

