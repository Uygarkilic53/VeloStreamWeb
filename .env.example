# ==============================================================================
# VeloStream Local Environment Configuration Template
# Copy to `.env` (never commit real `.env` files or `.keys/`).
# ==============================================================================

NODE_ENV=development

# PostgreSQL (owned by backend/fastify Prisma migrations)
POSTGRES_USER=velostream
POSTGRES_PASSWORD=velostream_dev_password
POSTGRES_DB=velostream
DATABASE_URL=postgresql://velostream:velostream_dev_password@localhost:5432/velostream?schema=public

# Asymmetric JWT keys (run `node infra/scripts/generate-keys.mjs` or `.ps1`/`.sh`)
JWT_ALGORITHM=EdDSA
JWT_ISSUER=velostream-fastify
JWT_AUDIENCE=velostream-clients
JWT_PRIVATE_KEY_PATH=./.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./.keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Fastify API (The Brain - Node.js)
FASTIFY_HOST=0.0.0.0
FASTIFY_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Fiber Service (The Muscle - Go Fiber)
FIBER_HOST=0.0.0.0
FIBER_PORT=3002

# MediaMTX Webhook Shared Secret
MEDIA_WEBHOOK_SECRET=dev_mediamtx_webhook_secret_change_me

# Cloudinary Media Storage (format: cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_AVATAR_FOLDER=VeloStream/avatar

# MediaMTX Endpoints
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WEBRTC_URL=http://localhost:8889

# Frontend (Vite public env vars - NEVER place private keys or DB secrets here)
VITE_CORE_API_URL=http://localhost:3001
VITE_REALTIME_HTTP_URL=http://localhost:3002
VITE_REALTIME_WS_URL=ws://localhost:3002
VITE_HLS_BASE_URL=http://localhost:8888
VITE_WHIP_BASE_URL=http://localhost:8889
